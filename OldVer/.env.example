# OBD2 AI Tool — environment configuration
# Copy to .env and customize

# Transport backend: j2534 | elm327 | socketcan | virtual
OBD2_TRANSPORT=j2534

# J2534 device selection
# Known shortcuts: opus_supergoose | autel_vcmi | obdlink
# Or full DLL path: C:\Program Files\Autel\MaxiFlash\J2534.dll
# Leave blank to auto-detect from Windows registry
OBD2_J2534_DLL=opus_supergoose
OBD2_J2534_DEVICE_INDEX=0

# ELM327 settings (only used when TRANSPORT=elm327)
# OBD2_ELM327_PORT=COM3
# OBD2_ELM327_BAUDRATE=38400

# SocketCAN settings (only used when TRANSPORT=socketcan)
# OBD2_SOCKETCAN_CHANNEL=can0
# OBD2_SOCKETCAN_BITRATE=500000

# UDS CAN IDs (override for non-standard vehicles)
# OBD2_UDS_TX_ID=0x7DF
# OBD2_UDS_RX_ID=0x7E8

# Anthropic API key (optional, for direct API usage alongside MCP)
# ANTHROPIC_API_KEY=sk-ant-...

# Logging
OBD2_MCP_LOG_LEVEL=INFO
